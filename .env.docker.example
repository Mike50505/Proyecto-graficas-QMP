# Copie a .env.docker y genere una clave aleatoria antes de iniciar.
SECRET_KEY=
APP_PORT=8766
ALLOWED_HOSTS=localhost,127.0.0.1
PLANT_TIME_ZONE=America/Mexico_City
MAX_EXCEL_BYTES=10485760
MAX_EXCEL_ROWS=50000
MAX_EXCEL_UNCOMPRESSED=104857600
# Solo para el archivo opcional compose.postgres.yaml:
POSTGRES_DB=fcd
POSTGRES_USER=fcd
POSTGRES_PASSWORD=
